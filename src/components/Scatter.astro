---
// Supply risk against economic importance, the two axes of the EU criticality
// assessment. Two colours (strategic or not), a legend, selective labels, and
// a tooltip on every point. The same data is in the table below the chart.
import { href, formatters } from '../lib/format';

export interface ScatterPoint {
  slug: string;
  name: string;
  short: string;
  x: number;
  y: number;
  strategic: boolean;
}
interface Props {
  locale: string;
  points: ScatterPoint[];
  xLabel: string;
  yLabel: string;
  xThreshold: number;
  yThreshold: number;
  legend: [string, string];
  thresholdNote: string;
}
const { locale, points, xLabel, yLabel, xThreshold, yThreshold, legend, thresholdNote } = Astro.props;
const F = formatters(locale);
const W = 760;
const H = 440;
const m = { l: 48, r: 20, t: 16, b: 44 };
const xMax = Math.max(10, Math.ceil(Math.max(...points.map((p) => p.x))));
const yMax = Math.max(6, Math.ceil(Math.max(...points.map((p) => p.y))));
const sx = (v: number) => m.l + (v / xMax) * (W - m.l - m.r);
const sy = (v: number) => m.t + (1 - v / yMax) * (H - m.t - m.b);
const xTicks = Array.from({ length: xMax / 2 + 1 }, (_, i) => i * 2);
const yTicks = Array.from({ length: yMax + 1 }, (_, i) => i);

// label the points a reader will look for first, skipping any that would collide
const ranked = [...points].sort((a, b) => b.y - a.y);
const placed: { x: number; y: number; w: number }[] = [];
const labels = new Map<string, { x: number; y: number; anchor: string }>();
for (const p of ranked) {
  const w = p.short.length * 6.2 + 6;
  const right = sx(p.x) + 9 + w < W - m.r;
  const lx = right ? sx(p.x) + 9 : sx(p.x) - 9 - w;
  const ly = sy(p.y);
  const clash = placed.some((q) => Math.abs(q.y - ly) < 13 && lx < q.x + q.w && q.x < lx + w);
  const onDot = points.some((q) => q.slug !== p.slug && Math.abs(sy(q.y) - ly) < 9 && sx(q.x) > lx - 6 && sx(q.x) < lx + w + 6);
  if (clash || onDot) continue;
  placed.push({ x: lx, y: ly, w });
  labels.set(p.slug, { x: right ? sx(p.x) + 9 : sx(p.x) - 9, y: ly + 3.5, anchor: right ? 'start' : 'end' });
}
---

<div class="scatter">
  <div class="legend">
    <span><i style="background:var(--series-1)"></i>{legend[0]}</span>
    <span><i style="background:var(--series-2)"></i>{legend[1]}</span>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label={`${yLabel} against ${xLabel} for ${points.length} materials`}>
    <rect class="zone" x={sx(xThreshold)} y={m.t} width={W - m.r - sx(xThreshold)} height={sy(yThreshold) - m.t}></rect>
    {yTicks.map((t) => <line class="gridline" x1={m.l} x2={W - m.r} y1={sy(t)} y2={sy(t)} />)}
    {xTicks.map((t) => <line class="gridline" x1={sx(t)} x2={sx(t)} y1={m.t} y2={H - m.b} />)}
    {yTicks.map((t) => <text x={m.l - 8} y={sy(t) + 3.5} text-anchor="end">{t}</text>)}
    {xTicks.map((t) => <text x={sx(t)} y={H - m.b + 16} text-anchor="middle">{t}</text>)}
    <line class="threshold" x1={sx(xThreshold)} x2={sx(xThreshold)} y1={m.t} y2={H - m.b}></line>
    <line class="threshold" x1={m.l} x2={W - m.r} y1={sy(yThreshold)} y2={sy(yThreshold)}></line>
    <text class="pt-label" x={W - m.r - 4} y={m.t + 12} text-anchor="end">{thresholdNote}</text>
    <text class="axis-title" x={(m.l + W - m.r) / 2} y={H - 6} text-anchor="middle">{xLabel}</text>
    <text class="axis-title" transform={`translate(12 ${(m.t + H - m.b) / 2}) rotate(-90)`} text-anchor="middle">{yLabel}</text>
    {
      points.map((p) => (
        <a href={href(`/materials/${p.slug}/`, locale)} data-tip={`${p.name}|${yLabel}: ${F.fixed(p.y, 1)}|${xLabel}: ${F.fixed(p.x, 1)}|${p.strategic ? legend[0] : legend[1]}`} aria-label={`${p.name}: ${yLabel} ${F.fixed(p.y, 1)}, ${xLabel} ${F.fixed(p.x, 1)}`}>
          <circle cx={sx(p.x)} cy={sy(p.y)} r="12" fill="transparent" />
          <circle class:list={['pt', p.strategic ? 's1' : 's2']} cx={sx(p.x)} cy={sy(p.y)} r="5" />
        </a>
      ))
    }
    {
      points
        .filter((p) => labels.has(p.slug))
        .map((p) => {
          const l = labels.get(p.slug)!;
          return (
            <text class="pt-label" x={l.x} y={l.y} text-anchor={l.anchor}>
              {p.short}
            </text>
          );
        })
    }
  </svg>
</div>
