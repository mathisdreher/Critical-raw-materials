---
import { formatters, direction } from '../lib/format';
interface Props {
  value: number | null | undefined;
  decimals?: number;
  locale?: string;
}
const { value, decimals = 1, locale = 'en' } = Astro.props;
const F = formatters(locale);
---

{value === null || value === undefined ? <span class="muted">n/a</span> : <span class="delta" data-dir={direction(value)}>{F.pct(value, decimals)}</span>}
