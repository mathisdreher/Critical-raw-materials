---
import Base from '../layouts/Base.astro';
import { ui, crma } from '../i18n';
import { REG_URL, AMEND_URL } from '../i18n/crma.en';
import { href, formatters } from '../lib/format';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = ui(locale);
const c = crma(locale);
const h = c.hub;
const F = formatters(locale);
const now = Date.now();
const SIX_MONTHS = 183 * 86400000;
const rows = c.deadlines.map((d) => {
  const ts = Date.parse(d.date);
  return { ...d, state: ts < now ? 'past' : ts - now < SIX_MONTHS ? 'soon' : 'upcoming' };
});
---

<Base locale={locale} current="crma" title={h.title} description={h.lede}>
  <div class="page-head">
    <p class="eyebrow">{c.regulationName}</p>
    <h1>{h.title}</h1>
    <p class="lede">{h.lede}</p>
  </div>

  <section aria-label={h.toolsTitle}>
    <div class="grid cols-3">
      {
        h.tools.map((tool) => (
          <div class="card tool-card">
            <span class="badge">{tool.ref}</span>
            <h2>{tool.title}</h2>
            <p class="muted">{tool.text}</p>
            <a class="btn" href={href(tool.path, locale)}>
              {tool.cta}
            </a>
          </div>
        ))
      }
    </div>
    <p class="fig-note">{c.disclaimer}</p>
  </section>

  <section class="section">
    <div class="callout warn">
      <strong>{h.amendTitle}.</strong>{' '}
      <span set:html={h.amendHtml} />{' '}
      <a href={AMEND_URL}>{h.amendLink}</a>. {h.amendAsOf}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>{h.whoTitle}</h2></div>
    <div class="grid cols-3">
      {
        h.who.map((w) => (
          <div class="card">
            <span class="badge">{w.ref}</span>
            <h3 style="margin-top:10px">{w.title}</h3>
            <p class="muted" style="margin:0">{w.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section" id="deadlines">
    <div class="section-head">
      <h2>{h.calendarTitle}</h2>
      <a class="btn ghost" href={href('/crma/deadlines.ics', locale)} download>{h.calendarDownload}</a>
    </div>
    <p class="muted" style="max-width:76ch">{h.calendarSub}</p>
    <div class="filters" data-filter-for="deadlines-table">
      <div class="seg" role="group" aria-label={h.cols.who}>
        <button type="button" data-attr="who" data-value="" aria-pressed="true">{h.filterAll}</button>
        <button type="button" data-attr="who" data-value="company" aria-pressed="false">{h.filterCompany}</button>
      </div>
    </div>
    <div class="table-scroll">
      <table class="data" id="deadlines-table">
        <thead>
          <tr>
            <th>{h.cols.date}</th>
            <th>{h.cols.what}</th>
            <th>{h.cols.who}</th>
            <th>{h.cols.ref}</th>
            <th>{h.cols.status}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((d) => (
              <tr data-who={d.who}>
                <td class="num" style="white-space:nowrap">{F.date(d.date)}</td>
                <td>{d.what}</td>
                <td>
                  <span class:list={['badge', { strategic: d.who === 'company' }]}>{h.audience[d.who]}</span>
                </td>
                <td style="white-space:nowrap">{d.ref}</td>
                <td>
                  <span class:list={['badge', { warn: d.state === 'soon' }]}>{d.state === 'past' ? h.past : d.state === 'soon' ? h.soon : h.upcoming}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="card" style="margin-top:16px">
      <h3>{h.pendingTitle}</h3>
      <ul class="prose" style="margin:0 0 10px">
        {h.pending.map((p) => <li>{p}</li>)}
      </ul>
      <p class="small" style="margin:0">{h.pendingNote}</p>
    </div>
    <p class="fig-note">
      {c.basis} <a href={REG_URL}>{c.regulationOnEurLex}</a>. {t.footer.disclaimer}
    </p>
  </section>
</Base>
