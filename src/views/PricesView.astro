---
import Base from '../layouts/Base.astro';
import Spark from '../components/Spark.astro';
import Delta from '../components/Delta.astro';
import { ui, materialName, dataLabel, seriesLabel } from '../i18n';
import { countryName } from '../lib/countries';
import { priceIndex, isStale } from '../lib/data';
import { href, formatters } from '../lib/format';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = ui(locale);
const p = t.prices;
const F = formatters(locale);
const H = (p: string, _l?: string) => href(p, locale);
const mn = (slug: string) => materialName(locale, slug);
const dl = (s: string) => dataLabel(locale, s);
const sl = (s: Parameters<typeof seriesLabel>[1]) => seriesLabel(locale, s);
const cn = (n: string) => countryName(n, locale);

const rank = { daily: 0, monthly: 1, annual: 2 } as const;
const rows = [...priceIndex.series].sort((a, b) => rank[a.frequency] - rank[b.frequency] || a.source.localeCompare(b.source) || a.material.localeCompare(b.material));
const sources = [...new Set(rows.map((r) => r.source_name))];
---

<Base locale={locale} current="prices" title={p.title} description={p.lede}>
  <div class="page-head">
    <h1>{p.title}</h1>
    <p class="lede">{p.lede}</p>
  </div>

  <section aria-label={p.layersTitle}>
    <div class="grid cols-4">
      {
        p.layers.map((l) => (
          <div class="card">
            <span class="badge freq">{l.freq}</span>
            <h3 style="margin-top:10px">{l.title}</h3>
            <p class="small" style="margin:0">{l.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="filters" data-filter-for="prices-table">
      <input type="search" placeholder={p.searchPlaceholder} aria-label={p.searchPlaceholder} />
      <div class="seg" role="group" aria-label={t.common.frequency}>
        <button type="button" data-attr="freq" data-value="" aria-pressed="true">{t.common.all}</button>
        <button type="button" data-attr="freq" data-value="daily" aria-pressed="false">{t.freq.daily}</button>
        <button type="button" data-attr="freq" data-value="monthly" aria-pressed="false">{t.freq.monthly}</button>
        <button type="button" data-attr="freq" data-value="annual" aria-pressed="false">{t.freq.annual}</button>
      </div>
      <select data-attr="source" aria-label={t.common.source}>
        <option value="">{p.filterSource}</option>
        {sources.map((s) => <option value={s}>{dl(s)}</option>)}
      </select>
      <span class="small"><span data-count>{rows.length}</span> {p.count} {t.common.shown}</span>
    </div>
    <div class="table-scroll">
      <table class="data" id="prices-table" data-sortable>
        <thead>
          <tr>
            <th data-sort="text">{t.common.material}</th>
            <th data-sort="text">{t.common.series}</th>
            <th>{t.common.frequency}</th>
            <th class="r">{t.common.latest}</th>
            <th data-sort="text">{t.common.period}</th>
            <th class="r" data-sort="num">{t.common.change}</th>
            <th class="r" data-sort="num">{t.common.change1y}</th>
            <th>{t.common.trend}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((s) => (
              <tr data-freq={s.frequency} data-source={s.source_name} data-search={`${mn(s.material)} ${sl(s)} ${dl(s.source_name)}`}>
                <td class="name" data-v={mn(s.material)}>
                  <a href={H(`/materials/${s.material}/#prices`)}>{mn(s.material)}</a>
                </td>
                <td>
                  {sl(s)}
                  <span class="sub">{dl(s.source_name)}</span>
                </td>
                <td>
                  <span class="badge freq">{t.freq[s.frequency]}</span>
                </td>
                <td class="r">
                  {F.number(s.latest)} <span class="muted">{s.unit}</span>
                </td>
                <td data-v={s.latest_date}>
                  {F.date(s.latest_date)}
                  {isStale(s) && <span class="sub">{p.stale}</span>}
                </td>
                <td class="r" data-v={s.change_pct ?? ''}>
                  <Delta value={s.change_pct} locale={locale} />
                </td>
                <td class="r" data-v={s.change_1y_pct ?? ''}>
                  <Delta value={s.change_1y_pct} locale={locale} />
                </td>
                <td>
                  <Spark values={s.spark} />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="fig-note">
      {p.changeNote} <a href={H('/methodology/')}>{t.footer.methodology}</a>
    </p>
  </section>
</Base>
